// Cloudflare Workers: the built React app (dist/) as static assets.
// Cloudflare runs `npm run Build`, then `npx wrangler deploy` from this folder.
{
  "name": "formulation-test-tracker",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Every address the app doesn't have a file for gets index.html, and
    // React Router shows the right page.
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
