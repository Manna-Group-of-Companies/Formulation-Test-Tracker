# Copy to tools/.env (never committed) and fill in.

# Supabase dashboard -> Connect -> "Session pooler". Put the database
# password in place of [YOUR-PASSWORD]. Used by: npm run migrate
DATABASE_URL=postgresql://postgres.nnjwggmixzkdzpeezayj:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
# Used by: npm run create-account
SUPABASE_URL=https://nnjwggmixzkdzpeezayj.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# The secret mixed into every PIN before it becomes the account password.
# Must equal the PIN_PEPPER Edge Function secret in Supabase. Changing it
# means every PIN has to be set again.
PIN_PEPPER=

# Supabase personal access token, only for deploying Edge Functions and
# setting their secrets (npm run deploy-functions). Revoke when not needed.
SUPABASE_ACCESS_TOKEN=
