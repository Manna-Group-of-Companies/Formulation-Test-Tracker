# Copy this file to .env and fill in the password.
#
# Supabase dashboard -> Connect (top of the project page) -> "Session pooler".
# Copy that connection string and put the database password in place of
# [YOUR-PASSWORD]. Use the pooler, not "Direct connection": the direct
# address only works on networks with IPv6, which Render doesn't have.
DATABASE_URL=postgresql://postgres.nnjwggmixzkdzpeezayj:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# PORT=3000
